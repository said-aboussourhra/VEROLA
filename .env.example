# ─────────────────────────────────────────────────────────────
#  VEROLA — environment
#  Copy to .env and fill in. Never commit the real .env.
# ─────────────────────────────────────────────────────────────

# Database (required)
# Vercel: use Vercel Postgres, Neon or Supabase and paste the pooled URL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Administrator access code (used at /login → Administrator access)
ADMIN_CODE=SAID2002

# Comma-separated emails that are always treated as admins
ADMIN_EMAILS=

# File storage ------------------------------------------------
# fs   = local disk (default)   |   blob = Vercel Blob
STORAGE_DRIVER=fs
# Local/self-hosted default is <project>/data/uploads
# On Vercel the filesystem is read-only: set a writable path or use blob.
UPLOAD_DIR=./data/uploads
# BLOB_READ_WRITE_TOKEN=

# Transactional email (service layer — currently not wired)
# RESEND_API_KEY=
# EMAIL_FROM=VEROLA <hello@verola.ma>

# Google OAuth (service layer — currently not wired)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Site
NEXT_PUBLIC_SITE_URL=https://verola.com
